# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).

# --- Servidor ---
PORT=3000

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geshab
DB_USER=
DB_PASSWORD=

# --- JWT ---
# Clave larga y aleatoria. Expiracion de 24 horas (RNF-02).
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- CORS ---
# Origen del frontend Ionic (por defecto, ionic serve usa el 8100)
CORS_ORIGIN=http://localhost:8100