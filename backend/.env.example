# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).

# --- Servidor ---
PORT=3000

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geshab
DB_USER=
DB_PASSWORD=

# --- JWT ---
# Clave larga y aleatoria. Expiracion de 24 horas (RNF-02).
# Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- CORS ---
# Origenes del frontend autorizados, separados por coma.
# 5173 es el puerto de Vite (npm run dev) y 8100 el de ionic serve.
CORS_ORIGIN=http://localhost:5173,http://localhost:8100
