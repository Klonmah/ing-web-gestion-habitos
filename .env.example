# Variables del frontend (Vite). Copiar a .env y ajustar si hace falta:
#
#   cp .env.example .env
#
# Solo las variables que empiezan con VITE_ quedan disponibles en el
# navegador, asi que aqui NUNCA van secretos.

# URL base de la API REST (rama backend). Si no se define, api.ts usa
# este mismo valor por defecto.
VITE_API_URL=http://localhost:3000/api
